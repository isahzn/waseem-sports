# Waseem Sports — environment template. Copy to `.env` and fill in.
# NEVER commit real keys: `.env` is gitignored.
# (Supabase key names stay as Supabase defines them — their dashboard and
# docs use exactly these names.)

# Public (safe in the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Your Supabase project URL, e.g. https://xyzcompany.supabase.co
# (base URL only — no /rest/v1 suffix; the code adds paths itself)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase "anon public" key (safe in the browser; RLS rules still apply)

# Server-only (NEVER prefix with NEXT_PUBLIC_ — these stay on the server)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase "service_role" key (bypasses RLS; server code only)
ORDER_TRACKING_SECRET=
# Random string; seals guest order-tracking links so only the buyer can
# look up their order (used from Phase 05)
SCHEDULED_JOBS_SECRET=
# Random string; password for the app's automated background endpoints
# (/api/cron/*) so only the scheduler can trigger them

# Admin area: shared password gate (decision D42).
# Set ADMIN_PASSCODE and /admin opens with ONE password field instead of an
# account. Leave it EMPTY to fall back to the Supabase admin-account login
# (`admin_users` + Auth), which then behaves exactly as before.
# WARNING: this password is the whole admin area — products, orders, stock,
# prices. A short or guessable one is a shop takeover. Use a long random
# string on anything reachable from the internet, and see docs/SECURITY.md.
ADMIN_PASSCODE=
# Random string (32+ bytes, e.g. `openssl rand -hex 32`); signs the admin
# session cookie. Rotating it signs everyone out without changing the password.
# Optional: without it the cookie is signed with a key derived from the
# passcode, which still means a forgery needs the passcode itself.
ADMIN_SESSION_SECRET=

# WhatsApp notifications = self-hosted WAHA on a VPS (decision D4)
WAHA_URL=
# e.g. https://waha.example.com
WAHA_API_KEY=
WAHA_HOOK_HMAC_KEY=
# Proves WAHA callbacks are genuine

# Rate limiting uses a Postgres table (decision D8) — no extra vendor
RATE_LIMIT_PROVIDER=postgres

# Decided later — leave empty until the vendor is chosen and docs verified.
# Email/SMS vendors must expose an HTTPS API (GoDaddy blocks SMTP).
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
IMAGE_SEARCH_PROVIDER=
IMAGE_SEARCH_API_KEY=
